    "lucide-react": "^1.70.0",
    "next": "15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3",
    "postcss": "8.5.32",
    "typescript": "^5.9.0",
    "vitest": "^3"
  }
