# Copy to .env and fill in real values. Never commit .env.

# --- Database -------------------------------------------------------------
# Local Docker Postgres. For Neon, DATABASE_URL is the pooled URL and
# DIRECT_URL is the direct (unpooled) URL.
DATABASE_URL="postgresql://mec:mec_dev_password@localhost:5432/mec?schema=public"
DIRECT_URL="postgresql://mec:mec_dev_password@localhost:5432/mec?schema=public"

# --- API ------------------------------------------------------------------
API_PORT=3001
API_URL="http://localhost:3001"
WEB_ORIGIN="http://localhost:3000"

# --- Security -------------------------------------------------------------
# At least 32 characters.
JWT_SECRET="replace-with-a-long-random-string"
# Base64 of exactly 32 random bytes: openssl rand -base64 32
TOTP_ENCRYPTION_KEY="replace-with-base64-32-bytes"

# --- Seed -----------------------------------------------------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Optional: seed one exchange rate for today.
SEED_LBP_PER_USD=""
